{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nox-voice",
  "version": "0.5.1",
  "identifier": "com.noxitro.nox-voice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "nox-voice",
        "visible": false,
        "width": 940,
        "height": 660,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "noxitro",
    "copyright": "Copyright (c) 2026 nitro",
    "homepage": "https://github.com/noxitro/nox-voice",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Windows 向けの常駐型 AI 音声入力",
    "longDescription": "ホットキーを押して話すと、フィラーと言い直しを取り除き句読点を整えたテキストを、いま入力中のアプリへそのまま貼り付ける常駐アプリ。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Japanese"
        ]
      }
    }
  }
}
