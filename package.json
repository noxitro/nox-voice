{
  "name": "nox-voice",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "npm run build && cargo build --release --features tauri/custom-protocol --manifest-path src-tauri/Cargo.toml",
    "e2e:hotkey": "node e2e/hotkey.mjs",
    "e2e:single-instance": "node e2e/single-instance.mjs",
    "e2e:picker-live": "node e2e/hotkey-picker-live.mjs",
    "sim": "npm run sim:instance && npm run sim:ui",
    "sim:instance": "cargo test --manifest-path src-tauri/Cargo.toml --lib instance::sim -- --nocapture",
    "sim:ui": "node e2e/sim-ui.mjs",
    "notices": "node scripts/third-party-notices.mjs src-tauri/target/release-extras/THIRD_PARTY_NOTICES.txt"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
